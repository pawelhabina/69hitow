{
  "name": "@music-crossword/desktop",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc -p tsconfig.json && electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "preview": "electron-vite preview",
    "verify:production-bundle": "node scripts/verify-production-bundle.mjs",
    "dist:mac": "pnpm build && pnpm verify:production-bundle && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "dist:mac:arm64": "pnpm build && pnpm verify:production-bundle && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:mac:x64": "pnpm build && pnpm verify:production-bundle && electron-builder --mac dmg zip --x64 --publish never",
    "dist:win": "pnpm build && pnpm verify:production-bundle && electron-builder --win nsis --x64 --publish never",
    "dist:win:arm64": "pnpm build && pnpm verify:production-bundle && electron-builder --win nsis --arm64 --publish never",
    "dist:all": "pnpm build && pnpm verify:production-bundle && electron-builder --mac dmg zip --win nsis --publish never"
  },
  "dependencies": {
    "@music-crossword/shared": "workspace:*",
    "@tanstack/react-query": "^5.76.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.15.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0",
    "wavesurfer.js": "^7.9.5",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "pl.hitow69.desktop",
    "productName": "69hitow",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "out/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  }
}
